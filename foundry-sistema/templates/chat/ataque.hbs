<div class="cpr-fieldbook cartao ataque">
  <header><h3>{{atacante}}: {{descricao}}</h3><span class="sabor">{{arma}}</span></header>
  <p class="placar">{{#if (ne ataque null)}}Ataque <b>{{ataque}}</b>{{#if cabecalho}} · {{/if}}{{/if}}{{cabecalho}}</p>
  {{#if falhaDaArma}}<p class="nota falha-da-arma"><b>Falha crítica da arma:</b> {{falhaDaArma.texto}}</p>{{/if}}
  <ol class="alvos">
    {{#each linhas}}
    <li class="alvo resultado-{{resultado}}">
      <div class="linha">
        <img src="{{img}}" alt="">
        <b>{{nome}}</b>
        <span class="rotulo">{{rotulo}}</span>
        {{#if contra}}<span class="contra">contra {{contra}}</span>{{/if}}
        {{#if metros}}<span class="contra">{{metros}} m</span>{{/if}}
      </div>
      {{#if dano}}
      <ul class="dano">
        {{#if dano.escudo}}<li>O escudo ({{dano.escudo}}) levou {{dano.escudoAblado}}.</li>{{/if}}
        {{#if (or dano.lugar (not dano.escudo))}}<li>Dano <b>{{dano.dano}}</b>{{#if multiplicador}} (2d6 × {{multiplicador}}){{/if}} contra SP {{dano.spEfetivo}}{{#if (ne dano.spEfetivo dano.sp)}} (de {{dano.sp}}){{/if}}{{#if dano.armadura}} ({{dano.armadura}}){{/if}}: {{#if dano.passou}}passaram {{dano.bruto}}{{#if (eq dano.local "cabeca")}} (cabeça ×2){{/if}}{{else}}a armadura segurou{{/if}}.</li>{{/if}}
        {{#if dano.pontoFraco}}<li>Ponto Fraco: +{{dano.pontoFraco}} no dano (primeiro acerto da rodada).</li>{{/if}}
        {{#if dano.bonus}}<li>Crítico: +{{dano.bonus}} direto no HP.</li>{{/if}}
        {{#if dano.deflexao}}<li>Deflexão de Dano: −{{dano.deflexao}} (primeiro dano da rodada).</li>{{/if}}
        <li><b>Perdeu {{dano.recebido}} HP</b> ({{dano.hpAntes}} → {{dano.hpDepois}}){{#if dano.ablado}}; a armadura perdeu {{dano.ablado}} de SP{{/if}}.</li>
        {{#each dano.lesoes}}<li class="lesao">Lesão crítica: <b>{{nome}}</b>.</li>{{/each}}
      </ul>
      {{#if hp}}<span class="barra-hp" style="--hp: {{hp}}%"></span>{{/if}}
      {{/if}}
      {{#each notas}}<p class="nota">{{this}}</p>{{/each}}
      {{#if municao}}
      {{#unless municao.resistencia.passou}}
      <div class="botoes">
        {{#if (eq municao.efeito "emp")}}<button type="button" data-cprf-acao="aplicarEmp" data-ator="{{municao.ator}}">Escolher itens EMP</button><button type="button" data-cprf-acao="encerrarMunicao" data-ator="{{municao.ator}}">Acabou o minuto</button>{{/if}}
        {{#if (eq municao.efeito "sleep")}}<button type="button" data-cprf-acao="encerrarMunicao" data-ator="{{municao.ator}}">Acordar (uma Ação de outra pessoa)</button>{{/if}}
        {{#if municao.itens.length}}<button type="button" data-cprf-acao="encerrarMunicao" data-ator="{{municao.ator}}">Acabou o minuto</button>{{/if}}
        {{#if (eq municao.efeito "incendiary")}}<button type="button" data-cprf-acao="apagarFogo" data-ator="{{municao.ator}}">Apagar fogo (uma Ação)</button>{{/if}}
      </div>
      {{/unless}}
      {{/if}}
    </li>
    {{/each}}
  </ol>
  {{#each notas}}<p class="nota">{{this}}</p>{{/each}}
  {{#if desfazer}}<div class="botoes"><button type="button" data-cprf-acao="desfazer">Desfazer</button></div>{{/if}}
</div>
