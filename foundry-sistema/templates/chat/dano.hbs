<div class="cpr-fieldbook cartao dano {{#if critico}}critico-sucesso{{/if}}{{#if net}} net{{/if}}">
  <header><h3>{{rotulo}}</h3></header>
  {{#if critico}}<p class="critico">Crítico: dois ou mais 6. +5 direto no HP e uma Lesão Crítica.</p>{{/if}}
  {{{dados}}}
  {{#if botoes.length}}<div class="botoes">{{#each botoes}}<button type="button" data-cprf-acao="{{#if acao}}{{acao}}{{else}}aplicarNet{{/if}}"{{#if onde}} data-onde="{{onde}}"{{/if}}>{{rotulo}}</button>{{/each}}</div>{{/if}}
</div>
