{{!-- O agarrão (agarrao.mjs; a wiki, "Agarrar e arremessar", p. 177): na Defesa da aba Combate do personagem e na ficha
do capanga. Sem agarrão, "Agarrar" e "Tomar" (o objeto na mão do alvo; o C51); agarrando, "Estrangular", "Derrubar" e "Soltar"; agarrado, "Escapar". --}}
<div class="botoes-resumo agarrao">
  {{#if (eq agarrao.papel "agarrando")}}
  <button type="button" class="acao" data-action="estrangular" data-tooltip="Uma Ação: o seu BODY direto no HP de quem você agarra, sem a armadura; se o levaria abaixo de 0, ele fica com 1 e desmaia; três rodadas seguidas, desmaia (wiki, p. 177)">ESTRANGULAR</button>
  <button type="button" class="acao" data-action="derrubar" data-tooltip="Uma Ação: o seu BODY direto no HP de quem você agarra, sem a armadura; ele cai, e o agarrão acaba (wiki, p. 177)">DERRUBAR</button>
  {{#if editavel}}{{#unless escudoHumano}}<button type="button" class="acao" data-action="usarEscudoHumano" data-tooltip="Uma Ação: usar quem você agarra como escudo humano, sem outro escudo equipado. Interpor é uma reação opcional em lugar da esquiva; não protege de corpo a corpo nem de tiros mirados na cabeça (wiki, p. 184)">ESCUDO HUMANO</button>{{/unless}}{{/if}}
  <button type="button" class="acao ligado" data-action="soltar" data-tooltip="{{#if escudoHumano.morto}}Uma Ação para soltar o escudo de cadáver{{else}}Soltar a pessoa viva é livre{{/if}} (wiki, p. 177/184)">SOLTAR</button>
  {{else if (eq agarrao.papel "agarrado")}}
  <button type="button" class="acao" data-action="escapar" data-tooltip="Uma Ação: DEX + Briga + 1d10 contra o de quem agarra, que resiste na janela de reação; empate é dele (wiki, p. 177)">ESCAPAR</button>
  {{else}}
  <button type="button" class="acao" data-action="agarrar" data-tooltip="Uma Ação, com uma mão livre: DEX + Briga + 1d10 contra o do alvo marcado (T), que resiste na janela de reação; empate é dele (wiki, p. 177)">AGARRAR</button>
  <button type="button" class="acao" data-action="tomar" data-tooltip="Uma Ação, com uma mão livre: o mesmo teste do agarrar; vencendo, a arma na mão do alvo marcado (T) fica com você (wiki, p. 177: quem vence agarra ou toma um objeto)">TOMAR</button>
  {{/if}}
</div>
{{#if agarrao}}<div class="medida agarrao" data-tooltip="Agarrados, os dois têm −2 em todas as ações; quem é agarrado não usa a Ação de Movimento e é arrastado; ninguém usa arma de duas mãos (wiki, p. 177)"><span>{{#if (eq agarrao.papel "agarrando")}}AGARRANDO{{else}}AGARRADO POR{{/if}}</span><b>{{#if agarrao.outro}}{{agarrao.outro}}{{else}}—{{/if}} · −2 em tudo</b></div>{{/if}}
{{#if escudoHumano}}<div class="medida escudo-humano"><span>ESCUDO HUMANO ATIVO</span><b>{{escudoHumano.token.name}}{{#if escudoHumano.morto}} · {{escudoHumano.pv.value}}/{{escudoHumano.pv.max}} PV · soltar: 1 Ação{{else}} · pessoa viva · soltar: livre{{/if}}</b></div>{{/if}}
