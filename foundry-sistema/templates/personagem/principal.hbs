<section class="tab principal {{tab.cssClass}}" data-group="primary" data-tab="principal">
  <h3>Atributos</h3>
  <ol class="atributos">
    {{#each atributos}}
    <li class="atributo" data-atributo="{{chave}}">
      <button type="button" class="rolar" data-action="rolarAtributo" data-atributo="{{chave}}" data-tooltip="Rolar {{sigla}} + 1d10">{{sigla}}</button>
      <input type="number" name="system.atributos.{{chave}}.valor" value="{{base}}" min="0" max="20">
      {{#if (ne valor base)}}<span class="efetivo" data-tooltip="Com os efeitos">{{valor}}</span>{{/if}}
    </li>
    {{/each}}
  </ol>

  <h3>Armas</h3>
  {{#if armas.length}}
  <table class="lista armas">
    <thead><tr><th>Arma</th><th>Ataque</th><th>Dano</th><th>CDT</th><th>Pente</th><th></th></tr></thead>
    <tbody>
      {{#each armas}}
      <tr data-item-id="{{id}}" class="{{#unless sistema.equipada}}guardada{{/unless}}">
        <td class="nome"><img src="{{img}}" alt=""> <a data-action="editarItem">{{nome}}</a>{{#if qualidade}} <small>{{qualidade}}</small>{{/if}}</td>
        <td class="num">+{{ataque}}</td>
        <td>{{sistema.dano}}</td>
        <td class="num">{{sistema.cdt}}</td>
        <td>{{#if sistema.pente.max}}{{sistema.pente.value}}/{{sistema.pente.max}}{{#if municao}} <small>{{municao}}</small>{{/if}}{{else}}—{{/if}}</td>
        <td class="acoes"><div class="botoes">
          <button type="button" data-action="atacar" data-tooltip="Atacar os alvos marcados (T)">Atacar</button>
          <button type="button" data-action="mirar" data-tooltip="Mirado (−8): cabeça, perna ou item na mão">Mirar</button>
          {{#if sistema.autofogo}}<button type="button" data-action="atacar" data-modo="autofogo" data-tooltip="Autofogo (×{{sistema.autofogo}}): 10 balas">Autofogo</button>{{/if}}
          {{#if sistema.supressivo}}<button type="button" data-action="atacar" data-modo="supressivo" data-tooltip="Fogo supressivo: 10 balas, todos a até 25 m">Supressivo</button>{{/if}}
          <button type="button" data-action="rolarDano" data-tooltip="Só rolar o dano">Dano</button>
          {{#if sistema.pente.max}}<button type="button" data-action="recarregar" data-tooltip="Recarregar">↻</button>{{/if}}
        </div></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}<p class="vazio">Sem armas. Arraste uma arma para a ficha.</p>{{/if}}

  <h3>Lesões críticas</h3>
  <ol class="itens lesoes">
    {{#each lesoes}}
    <li data-item-id="{{id}}">
      <img src="{{img}}" alt="">
      <a class="nome" data-action="editarItem">{{nome}}</a>
      <span class="detalhe">{{resumo}}{{#if sistema.aumentaDeathSave}} · Death Save +1{{/if}}</span>
      <button type="button" class="apagar" data-action="apagarItem" data-tooltip="Tratada: tirar da ficha">✕</button>
    </li>
    {{else}}<li class="vazio">Sem lesões.</li>{{/each}}
  </ol>
</section>
