{{!-- A aba Vida, no jeito da maquete "Lifepath Tab" do usuário: o Lifepath em painéis (as origens, os valores, a família,
as metas e as pessoas), o Lifepath da Role e as notas. --}}
<section class="tab vida {{tab.cssClass}}" data-group="primary" data-tab="vida">
  <div class="duas-colunas lifepath-grupos">
    {{#each lifepathGrupos}}
    <section class="painel corte grupo-lifepath {{#if largo}}largo{{/if}}">
      <div class="titulo">{{titulo}}<span>{{sub}}</span></div>
      {{#each campos}}
      <label class="campo-lifepath">
        <span>{{rotulo}}</span>
        <textarea name="system.lifepath.{{chave}}" rows="{{linhas}}" aria-label="{{rotulo}}">{{valor}}</textarea>
      </label>
      {{/each}}
    </section>
    {{/each}}
  </div>

  <section class="painel corte notas">
    <div class="titulo">NOTAS<span>APARÊNCIA, HISTÓRIA, O QUE QUISER</span></div>
    {{#if editavel}}
    <prose-mirror name="system.notas" value="{{fonte.notas}}" toggled="true" compact="false">{{{notasRicas}}}</prose-mirror>
    {{else}}
    <div class="texto">{{{notasRicas}}}</div>
    {{/if}}
  </section>
</section>
